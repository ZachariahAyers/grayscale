{
  "name": "grayscale",
  "version": "2.0.0",
  "private": true,
  "description": "Convert PNG images to grayscale in the browser with a Rust kernel compiled to WebAssembly.",
  "license": "Apache-2.0",
  "author": "Zachariah Ayers (https://ayers.repair)",
  "repository": "github:ZachariahAyers/grayscale",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "wasm": "wasm-pack build --target web",
    "dev": "npm run wasm -- --dev && vite",
    "build": "npm run wasm && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "wasm-pack": "^0.15.0"
  },
  "dependencies": {
    "@fontsource/pacifico": "^5.3.0"
  }
}
